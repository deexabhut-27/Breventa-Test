NODE_ENV=development
PORT=5050

# MongoDB Atlas or self-hosted replica set
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=breventa-test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
ADMIN_JWT_EXPIRES_IN=8h
STUDENT_JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Nginx/a load balancer)
TRUST_PROXY=0
LOG_LEVEL=info

# Examination engine
MONITOR_INTERVAL_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=15
SUBMISSION_GRACE_SECONDS=5

# Used by `npm run seed` to create the first SUPER_ADMIN
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=ChangeMe123
