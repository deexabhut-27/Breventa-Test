{
  "name": "placement-exam-backend",
  "version": "1.0.0",
  "private": true,
  "description": "University Placement Examination System - REST API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/seed.js --admin-only",
    "test": "vitest run",
    "loadtest": "node scripts/loadTest.js",
    "questions:add": "node scripts/addQuestions.js",
    "test:watch": "vitest",
    "admin:reset": "node scripts/resetAdminPassword.js",
    "admin:create": "node scripts/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "2.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
